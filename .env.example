# Environment Variables Template
# Copy this file to .env and fill in the values

# ==========================================
# BACKEND SETTINGS
# ==========================================
# Port for the Node.js Express server
PORT=5000

# MongoDB Connection String (e.g., mongodb://localhost:27017/seo-article-generator)
MONGODB_URI=mongodb://localhost:27017/seo-article-generator

# OpenAI API Key (Get yours at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_here

# ==========================================
# FRONTEND SETTINGS (in frontend/.env)
# ==========================================
# API URL for the frontend to connect to the backend
VITE_API_URL=http://localhost:5000/api
