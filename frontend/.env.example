# =============================================================================
#  SEO Gen AI — Frontend Environment Configuration
#  1. Copy this file:  cp frontend/.env.example frontend/.env
#  2. Fill in every REPLACE_WITH_… value before starting the dev server.
#  NEVER commit .env to version control — it is already in .gitignore.
# =============================================================================

# ─── API CONNECTION ───────────────────────────────────────────────────────────

# Full URL of your Express backend API, including the /api prefix.
#   Development : http://localhost:5000/api
#   Production  : https://your-backend.vercel.app/api
# No trailing slash.
VITE_API_URL=http://localhost:5000/api

# ─── STRIPE — SUBSCRIPTION PRICE IDs ─────────────────────────────────────────
# Optional — remove or leave empty to hide the /pricing subscription page.
#
# How to get Price IDs:
#   1. Go to https://dashboard.stripe.com/products
#   2. Create a product per plan with RECURRING monthly billing.
#   3. Copy the Price ID (format: price_1XXXXXXXXXXXXXXXXXXXXXXXXXX).
#   4. Use TEST mode Price IDs during development, LIVE mode in production.
#
# Suggested default plan pricing (customise to your market):

# Starter Plan — e.g. $9 / month — 20 credits per month
VITE_STRIPE_PRICE_STARTER=price_REPLACE_WITH_YOUR_STARTER_PRICE_ID

# Growth Plan — e.g. $29 / month — 100 credits per month
VITE_STRIPE_PRICE_GROWTH=price_REPLACE_WITH_YOUR_GROWTH_PRICE_ID

# Pro Plan — e.g. $99 / month — 500 credits per month
VITE_STRIPE_PRICE_PRO=price_REPLACE_WITH_YOUR_PRO_PRICE_ID

# ─── SENTRY — ERROR TRACKING ──────────────────────────────────────────────────
# Optional — omit to disable error reporting (app still works without it).
# Sign up at https://sentry.io → create a React project → copy the DSN.
VITE_SENTRY_DSN=REPLACE_WITH_YOUR_SENTRY_DSN
