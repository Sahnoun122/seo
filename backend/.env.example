# =============================================================================
#  SEO Gen AI — Backend Environment Configuration
#  1. Copy this file:  cp backend/.env.example backend/.env
#  2. Fill in every REPLACE_WITH_… value before starting the server.
#  NEVER commit .env to version control — it is already in .gitignore.
# =============================================================================

# ─── SERVER ───────────────────────────────────────────────────────────────────

# HTTP port the Express server listens on (default: 5000).
PORT=5000

# Runtime environment. Controls logging verbosity and security checks.
# Values: development | test | production
NODE_ENV=development

# ─── DATABASE ─────────────────────────────────────────────────────────────────

# MongoDB connection string.
#   Local instance : mongodb://localhost:27017/seo-gen-ai
#   MongoDB Atlas  : mongodb+srv://<user>:<password>@cluster.mongodb.net/seo-gen-ai
# Docs: https://www.mongodb.com/docs/manual/reference/connection-string/
MONGODB_URI=mongodb://localhost:27017/seo-gen-ai

# ─── SECURITY ─────────────────────────────────────────────────────────────────

# Secret used to sign and verify JWT tokens. Use a long, random string.
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum recommended length: 64 characters.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# AES-256 encryption key for sensitive data stored in MongoDB
# (user API keys, WordPress application passwords).
# MUST be exactly 32 characters — no more, no less.
# Generate one: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_CHARACTERS_!!

# Allowed origin(s) for CORS. Set to your frontend URL.
#   Development : http://localhost:5173
#   Production  : https://app.yourdomain.com
# Multiple origins (comma-separated): https://app.example.com,https://www.example.com
CLIENT_URL=http://localhost:5173

# ─── AI / OPENAI ──────────────────────────────────────────────────────────────

# Platform-level OpenAI API key used when users have no personal key configured.
# Users who provide their own key in Settings bypass this key entirely.
# Get yours at: https://platform.openai.com/api-keys
# Leave blank to force all users to provide their own key.
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_OPENAI_KEY

# Default AI model for article generation and DALL-E 3 cover images.
# GPT-4o options   : gpt-4o | gpt-4o-mini
# OpenRouter free  : meta-llama/llama-3.1-8b-instruct:free
# DeepSeek         : deepseek-chat
OPENAI_MODEL=gpt-4o

# Optional: override the API base URL to use OpenRouter, DeepSeek, Groq,
# or any other OpenAI-compatible API endpoint.
# Uncomment and set one of the following:
#   OpenRouter : https://openrouter.ai/api/v1
#   DeepSeek   : https://api.deepseek.com/v1
#   Groq       : https://api.groq.com/openai/v1
# Leave commented to use the official OpenAI endpoint.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ─── EMAIL — PASSWORD RESET ───────────────────────────────────────────────────

# Resend API key — used for password-reset and transactional emails.
# Free tier: 3,000 emails/month. Sign up at https://resend.com.
# Get your key at: https://resend.com/api-keys
# If omitted in development, reset URLs are printed to the server console.
RESEND_API_KEY=re_REPLACE_WITH_YOUR_RESEND_KEY

# Verified sender address. Must match a domain you verified in Resend.
# Resend sandbox: use onboarding@resend.dev for testing without domain verification.
EMAIL_FROM=noreply@yourdomain.com

# ─── STRIPE — PAYMENTS ────────────────────────────────────────────────────────
# Optional — omit this entire block to disable all payment features.
# Test keys begin with sk_test_  |  Live keys begin with sk_live_

# Stripe Secret API key.
# Get from: https://dashboard.stripe.com/apikeys (toggle Test / Live mode).
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY

# Webhook signing secret — validates that webhook events come from Stripe.
# Local dev : run  stripe listen --forward-to localhost:5000/api/stripe/webhook
#             and copy the  whsec_…  secret it prints.
# Production: Stripe Dashboard → Developers → Webhooks → Add endpoint
#             → reveal Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_WEBHOOK_SIGNING_SECRET

# ─── UNSPLASH — PHOTO SEARCH ─────────────────────────────────────────────────
# Optional — omit to disable the Unsplash photo picker in the article editor.
# Sign up at https://unsplash.com/developers → create an app → copy Access Key.
# Free tier: 50 requests/hour for demo apps; apply for Production for 5,000/hour.
UNSPLASH_ACCESS_KEY=REPLACE_WITH_YOUR_UNSPLASH_ACCESS_KEY

# ─── SENTRY — ERROR TRACKING ──────────────────────────────────────────────────
# Optional — omit to disable error reporting (app still works without it).
# Sign up at https://sentry.io → create a Node.js project → copy the DSN.
SENTRY_DSN=REPLACE_WITH_YOUR_SENTRY_DSN

# ─── IMAGE STORAGE ────────────────────────────────────────────────────────────
# The platform supports three storage backends — choose ONE and uncomment it.
# If ALL variables are left blank, images are stored on local disk (dev only).
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  OPTION 1 — MinIO (self-hosted, recommended for VPS/Docker deployments) │
# │  Free, open-source, S3-compatible. Run with:                            │
# │    docker run -p 9000:9000 -p 9001:9001                                 │
# │      -e MINIO_ROOT_USER=accesskey                                        │
# │      -e MINIO_ROOT_PASSWORD=secretkey                                    │
# │      minio/minio server /data --console-address ":9001"                 │
# └─────────────────────────────────────────────────────────────────────────┘
# S3_ENDPOINT=http://YOUR_SERVER_IP:9000
# S3_ACCESS_KEY=REPLACE_WITH_YOUR_MINIO_ACCESS_KEY
# S3_SECRET_KEY=REPLACE_WITH_YOUR_MINIO_SECRET_KEY
# S3_BUCKET=seo-gen-ai
# S3_REGION=us-east-1

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  OPTION 2 — Cloudflare R2 (FREE — 10 GB/month, no egress fees)         │
# │  Create account: https://dash.cloudflare.com → R2 → Create bucket      │
# │  Get API token: R2 → Manage API tokens → Create API token              │
# └─────────────────────────────────────────────────────────────────────────┘
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY=REPLACE_WITH_YOUR_R2_ACCESS_KEY_ID
# S3_SECRET_KEY=REPLACE_WITH_YOUR_R2_SECRET_ACCESS_KEY
# S3_BUCKET=seo-gen-ai
# S3_REGION=auto

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  OPTION 3 — AWS S3 (scalable, paid per GB)                             │
# │  Create bucket: https://s3.console.aws.amazon.com                      │
# │  IAM permissions required: s3:GetObject, s3:PutObject, s3:DeleteObject │
# └─────────────────────────────────────────────────────────────────────────┘
# AWS_REGION=eu-west-3
# AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_AWS_SECRET_ACCESS_KEY
# AWS_S3_BUCKET=your-s3-bucket-name

