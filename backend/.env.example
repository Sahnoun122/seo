# ==========================================
#  AI SEO Article Generator - Server Config
# ==========================================

# 🚀 Server Settings
PORT=5000

# 💾 Database Configuration
# Replace with your MongoDB connection string (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/seo-article-generator

# 🔐 Security Configuration
# Used to sign JWT authorization tokens. Replace with a long random secret key.
JWT_SECRET=super_secret_jwt_key_change_me_in_production!

# Used to encrypt sensitive user data (API keys, WordPress passwords) stored in the database.
# Must be exactly 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
ENCRYPTION_KEY=change_this_to_a_32_char_secret!!

# Allowed client origin(s) for CORS. In production set this to your frontend URL.
# Multiple origins can be separated by commas: https://app.example.com,https://www.example.com
CLIENT_URL=https://your-frontend.vercel.app

# 🤖 OpenAI API Configurations
# Your official OpenAI API Key (or a compatible LLM provider like OpenRouter)
OPENAI_API_KEY=your_openai_api_key_here

# The LLM model to use for article generation (e.g. gpt-4o, gpt-3.5-turbo, openrouter/free)
OPENAI_MODEL=gpt-4o

# Optional: Base URL if routing requests via proxies or alternative services (like OpenRouter)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ☁️ AWS S3 Storage Configuration (For Article Images)
# Region where your bucket is hosted (e.g. us-east-1, eu-west-3)
AWS_REGION=us-east-1

# Your IAM user access keys with S3 read/write permissions
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# S3 Bucket Name
AWS_S3_BUCKET=your_s3_bucket_name_here
